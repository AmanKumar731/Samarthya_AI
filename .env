# ==============================================================================
# SAMARTHYA AI / SAKSHAM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Application Server & Environment ---
ENVIRONMENT=development
APP_NAME=Samarthya-AI
DEBUG=true
PORT=3000
HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# --- Backend FastAPI Microservice ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000

# --- Frontend Framework Endpoints (Vite / Next.js / React) ---
VITE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
REACT_APP_API_URL=http://127.0.0.1:8000

# --- Security & CORS Origins ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# --- Google Maps Platform API ---
# Powers partner locator for CSC Kendra, bank branches, and disability centres
GOOGLE_MAPS_API_KEY=AIzaSyCAr8uQ9RT2zy_e5M0xaY-sckO9xd4ZrEk
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyCAr8uQ9RT2zy_e5M0xaY-sckO9xd4ZrEk
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCAr8uQ9RT2zy_e5M0xaY-sckO9xd4ZrEk

# --- Google Gemini AI API ---
# Powers Saksham AI conversational intelligence, reasoning, and multi-turn NLU
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Open Government Data (data.gov.in) API ---
# Access to central sector schemes and public welfare datasets
DATA_GOV_API_KEY=579b464db66ec23bdd0000012de7a95fb50f4b3175bfe1853d516066
DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# --- Digital India BHASHINI API ---
# National Language Translation Mission for Indian regional languages
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# --- Firebase Authentication & Cloud Database ---
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=samarthya-ai.firebaseapp.com
FIREBASE_PROJECT_ID=samarthya-ai
FIREBASE_STORAGE_BUCKET=samarthya-ai.appspot.com
